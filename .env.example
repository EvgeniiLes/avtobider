# Яндекс OAuth: приложение «Автобидер» (oauth.yandex.ru). Значения задаются только здесь и в .env на сервере.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Приложение для входа через Яндекс ID (тип «Для авторизации пользователей»)
YANDEX_LOGIN_CLIENT_ID=
YANDEX_LOGIN_CLIENT_SECRET=
# Адрес, куда Яндекс возвращает пользователя после входа, например https://ваш-домен.ru/auth/yandex/callback
YANDEX_REDIRECT_URI=
# Как часто фоновый процесс обновляет данные из Директа и принимает решения, минут
WORKER_INTERVAL_MINUTES=30

# Режим: development включает кнопку «Взять токен с сервера» (только для своего компьютера).
# На сервере для пользователей оставьте пустым или production.
APP_ENV=
# Тестовый токен для разработки на своём кабинете (не для продакшена)
YANDEX_DEV_TOKEN=

# Ключ шифрования токенов кабинетов. Если пусто, создастся файл data/secret.key.
# На сервере задайте свой: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Потеряете ключ: сохранённые кабинеты придётся подключить заново.
SECRET_KEY=

# Версия API Директа (по умолчанию v501; песочница Директа закрыта с 15.07.2026)
DIRECT_API_VERSION=v501
# Логин рекламного кабинета (нужен агентствам или если токен выдан на другой логин; обычно пусто)
DIRECT_CLIENT_LOGIN=

# Ключ Claude для текстов объявлений. Без него тексты собираются по шаблону
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Ключ fal.ai для картинок и видео. Без него эта часть выключена. Модели можно менять без правки кода
FAL_KEY=
# Картинки: fal-ai/nano-banana-2 (дёшево, по умолчанию) или fal-ai/nano-banana-pro (сложные сцены).
# Видео: fal-ai/kling-video/v3/pro/image-to-video (по умолчанию) или xai/grok-imagine-video/image-to-video (дешевле).
# Тексты через fal.ai: запасной путь, если Anthropic не принимает запросы с вашего сервера (так с российскими IP).
FAL_TEXT_MODEL=anthropic/claude-sonnet-5.5
# Баннер целиком, с текстом на картинке (стиль «ИИ-дизайн»): модель, которая умеет писать по-русски
# GPT Image 2 в формате 4:3 среднего качества: около 3.7 цента за баннер. Запасной вариант: fal-ai/nano-banana-pro (15 центов)
FAL_BANNER_MODEL=openai/gpt-image-2
FAL_IMAGE_MODEL=fal-ai/nano-banana-2
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# Сколько долларов можно потратить на создание текстов, картинок и видео на один бизнес
GEN_LIMIT_USD=5
# Курс для показа цен генерации в рублях на сайте (расчёты с fal.ai идут в долларах). Поправляйте, когда курс уходит далеко
USD_RUB_RATE=95

# Путь к базе данных
DB_PATH=data/app.db
